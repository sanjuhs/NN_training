RUNPOD_TEMPLATE=Runpod PyTorch
RUNPOD_CLOUD=Community
RUNPOD_GPU=RTX 3090 24GB
RUNPOD_FALLBACK_GPUS=RTX A5000 24GB,L4 24GB,RTX 4090 24GB
RUNPOD_PUBLIC_IP=true
RUNPOD_SSH_ENABLED=true
RUNPOD_EXPOSED_PORTS=22/tcp,8888/http
RUNPOD_CONTAINER_DISK_GB=50
RUNPOD_VOLUME_GB=50
RUNPOD_VOLUME_MOUNT_PATH=/workspace
RUNPOD_WORKDIR=/workspace/NN_training
RUNPOD_PYTORCH_VERSION=2.8.0
RUNPOD_TORCHAUDIO_VERSION=2.8.0
RUNPOD_CUDA_SERIES=12.8
RUNPOD_NOTES=Use on-demand first, then switch to spot after checkpointing is verified.
